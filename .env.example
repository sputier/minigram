# Copier ce fichier vers .env (jamais commité) et renseigner les vraies valeurs.

# Obtenus sur https://my.telegram.org/
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Clé de chiffrement du storage TDLib local (td_db). Choisie par le parent,
# une chaîne aléatoire suffisamment longue. Ne JAMAIS la perdre : sans elle,
# la session/le cache TDLib existant devient illisible.
TDLIB_ENCRYPTION_KEY=

# Mot de passe pour déverrouiller le gate admin (raccourci Ctrl+Alt+Shift+P).
# Choisi par le parent, reste uniquement sur cette machine.
ADMIN_PASSWORD=

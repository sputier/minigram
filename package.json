{
  "name": "minigram",
  "private": true,
  "version": "0.1.5",
  "description": "Client Telegram parental pour enfant",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win",
    "publish": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.sputier.minigram",
    "productName": "MiniGram",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tdl/**",
      "node_modules/prebuilt-tdlib/**",
      "node_modules/@prebuilt-tdlib/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MiniGram",
      "language": "1036"
    },
    "publish": {
      "provider": "github",
      "owner": "sputier",
      "repo": "minigram"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "prebuilt-tdlib": "^0.1008065.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tdl": "^8.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.9"
  }
}
